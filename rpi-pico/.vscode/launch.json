{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "RPI Pico Debug",
      "type": "probe-rs-debug",
      "request": "launch",
      "preLaunchTask": "Build Debug",
      "chip": "rp2040",
      "connectUnderReset": false,
      "speed": 4000,
      "flashingConfig": {
        "flashingEnabled": true
      },
      "coreConfigs": [
        {
          "coreIndex": 0,
          "programBinary": "${env:PICO_ROOT_DIR}/target/thumbv6m-none-eabi/debug/${workspaceFolderBasename}",
          "svdFile": "${env:PICO_ROOT_DIR}/rp2040.svd",
          "rttEnabled": true
        }
      ],
      "consoleLogLevel": "Info", //Error, Warn, Info, Debug, Trace
      "wireProtocol": "Swd"
    }
  ]
}
