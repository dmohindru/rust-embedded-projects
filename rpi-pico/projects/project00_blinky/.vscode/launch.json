{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Raspberry Pi Pico Debug",
      "type": "probe-rs-debug",
      "request": "launch",
      "preLaunchTask": "Build Debug",
      "flashingConfig": {
        "flashingEnabled": true
      },
      "chip": "RP2040",
      "coreConfigs": [
        {
          "programBinary": "${workspaceFolder}/../../target/thumbv6m-none-eabi/debug/${workspaceFolderBasename}"
        }
      ]
    }
  ]
}
